{
  "material": {
    "repo": "https://example.com/demo.git",
    "depth": 1
  },
  "download": [
    "https://example.com/tool.zip",
    { "url": "https://example.com/win.exe", "system": "win_amd64" }
  ],
  "unzip": [
    "local-assets.zip",
    { "file": "win-only.zip", "system": "win_amd64", "extract": true }
  ],
  "unpack": [
    "https://example.com/bundle.zip",
    { "url": "https://example.com/win-tools.zip", "system": "win_amd64", "extract": true }
  ],
  "env": [
    { "key": "hello", "value": "world" },
    { "key": "world", "value": "hello;world", "system": "win_arm64" }
  ],
  "data": ["build.sh"],
  "jobs": {
    "main": {
      "env": [{ "key": "CC", "value": "clang" }],
      "steps": {
        "call-hello": {
          "call": { "hello.json": ["world"] }
        },
        "banner": {
          "run": [["echo", "build start"]],
          "env": [{ "key": "CC", "value": "gcc" }]
        }
      }
    },
    "isolated": {
      "skip": true,
      "area": [{ "key": "PATH_EXTRA", "value": "toolchain" }],
      "steps": {
        "show": {
          "run": [["echo", "isolated env"]]
        }
      }
    }
  }
}
